{
  "openapi": "3.0.0",
  "info": {
    "title": "Store Front API Documentation",
    "version": "1.0.0",
    "contact": {
      "name": "Store Front API",
      "url": "https://storefrontsmes-aug-api.amalitech-dev.net/",
      "email": "richard.bouaro@amalitech.org"
    }
  },
  "servers": [
        {
      "url": "https://storefrontsmes-aug-api.amalitech-dev.net/",
      "description": "Store Front API"
    }
  ],
  "components": {
    "securitySchemas": {
      "bearerAuth": {
        "type": "https",
        "schema": "bearerAuth",
        "bearerFormat": "cookie"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "default": "error"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "default": "error"
          },
          "error": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "validation": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
    
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["Business", "Customer"]
          },
            "provider": {
            "type": "string",
            "enum": ["local", "google", "facebook"]
          },
          "verificationToken": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "default": false
          },
          "isActive": {
            "type": "boolean",
            "default": false
          },
          "mustChangePassword": {
            "type": "boolean",
            "default": false
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "Accounts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
             "id": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["Business", "Customer"]
          },
            "provider": {
            "type": "string",
            "enum": ["local", "google", "facebook"]
          },
          "verificationToken": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "default": false
          },
          "isActive": {
            "type": "boolean",
            "default": false
          },
          "mustChangePassword": {
            "type": "boolean",
            "default": false
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/account/register/local": {
      "post": {
        "tags": ["Account"],
        "summary": "Register a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessName": {
                    "type": "string",
                    "default": "Menvrick Corporation"
                  },
                  "email": {
                    "type": "string",
                    "default": "msmith@example.com"
                  },
                  "type": {
                    "type": "string",
                    "default": "Customer",
                    "enum": ["Business", "Customer"]
                  },
                  "provider": {
                    "type": "string",
                    "default": "local",
                    "enum": ["local", "google", "facebook"]
                  },
                  "password": {
                    "type": "string",
                    "default": "oWusu247",
                    "format": "password"
                  },
                  "confirmPassword": {
                    "type": "string",
                    "default": "oWusu247",
                    "format": "password"
                  }
                },
                "required": [
                  "BusinessName",
                  "provider",
                  "email",
                  "type",
                  "password",
                  "confirmPassword"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CREATED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "default": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Account"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "content": {
              "application/json": {
                "$ref": "#/components/schemas/ValidationErrorResponse"
              }
            }
          },
          "409": {
            "description": "CONFLICT",
            "content": {
              "application/json": {
                 "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "500": {
            "description": "INTERNAL SERVER ERROR",
            "content": {
              "application/json": {
                 "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "tags": []
}