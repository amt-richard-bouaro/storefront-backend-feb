    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "default": "error"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "default": "error"
          },
          "error": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "validation": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
    
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["Business", "Customer"]
          },
          "verified": {
            "type": "boolean",
            "default": false
          },
          "isActive": {
            "type": "boolean",
            "default": false
          },
          "mustChangePassword": {
            "type": "boolean",
            "default": false
          },
          "canResetPassword": {
            "type": "boolean",
            "default": false
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "Accounts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
             "id": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["Business", "Customer"]
          },
          "verified": {
            "type": "boolean",
            "default": false
          },
          "isActive": {
            "type": "boolean",
            "default": false
          },
          "mustChangePassword": {
            "type": "boolean",
            "default": false
          },
          "canResetPassword": {
            "type": "boolean",
            "default": false
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/account/register/local": {
      "post": {
        "tags": ["Account"],
        "summary": "This endpoint allows a new customer/business create an account within our system. Customers/businesses are users who can interact with our platform to access/promote various services and products. To create a customer account for instance, you need to provide essential information such as their first name, last name, email address,type (Customer) and password (with password confimation). Upon successful creation, the customer will be able to log in and start using our services.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessName": {
                    "type": "string",
                    "default": "Menvrick Corporation"
                  },
                  "email": {
                    "type": "string",
                    "default": "msmith@example.com"
                  },
                  "type": {
                    "type": "string",
                    "default": "Business",
                    "enum": ["Business", "Customer"]
                  },
                  "password": {
                    "type": "string",
                    "default": "oWusu247",
                    "format": "password"
                  },
                  "confirmPassword": {
                    "type": "string",
                    "default": "oWusu247",
                    "format": "password"
                  }
                },
                "required": [
                  "BusinessName",
                  "email",
                  "type",
                  "password",
                  "confirmPassword"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CREATED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "default": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Account"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "content": {
              "application/json": {
                "schema": {
                "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                 "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL SERVER ERROR",
            "content": {
              "application/json": {
                "schema": {
                 "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/login/local": {
      "post": {
        "tags": ["Account"],
        "summary": "This endpoint allows a new customer/business to login to their account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                 
                  "email": {
                    "type": "string",
                    "default": "msmith@example.com"
                  },
                  
                  "password": {
                    "type": "string",
                    "default": "oWusu247",
                    "format": "password"
                  }
                  
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LOGGED_IN",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "default": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Account"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "BAD REQUEST",
            "content": {
              "application/json": {
                "schema": {
                "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                 "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL SERVER ERROR",
            "content": {
              "application/json": {
                "schema": {
                 "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/verify": {
      "post": {
        "tags": ["Account"],
        "summary": "This endpoint allows a new customer/business verify their registered account by providing a short code sent to the their email address after successfully creating their account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "default": "A940SR"
