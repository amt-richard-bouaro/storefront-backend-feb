generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Type {
  Business
  Customer
}

enum Provider {
  local
  google
  facebook
}

model Account {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  type               Type
  provider           Provider
  providerId         String    @default(uuid())
  verificationToken  String?
  verified           Boolean   @default(false)
  isActive           Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  canResetPassword   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer? @relation("customerAccount")
  business           Business? @relation("businessAccount")
}

model Customer {
  id              String      @id @default(uuid())
  firstName       String
  lastName        String
  phone           String?
  reviews         Review[]    @relation("customerReviews")
  Replies         Reply[]     @relation("customerReply")
  orders          Order[]     @relation("customerOrder")
  savedProduct    SavedItem[] @relation("customerSavedProduct")
  visitedStores   Visitor[]   @relation("visitedStore")
  shipping        Shipping[]  @relation("customerShipping")
  account         String      @unique
  customerAccount Account     @relation("customerAccount", fields: [account], references: [id], onDelete: Cascade)
}

model Shipping {
  id               String   @id @default(uuid())
  countryCode      String
  postalCode       String
  name         String
  streetAddress    String
  apartmentNo     String?
  city             String
  phone            String
  orders           Order[]  @relation("orderShipping")
  isActive         Boolean  @default(true)
  customer         String
  customerShipping Customer @relation("customerShipping", fields: [customer], references: [id], onDelete: Cascade)
}

model Business {
  id              String            @id @default(uuid())
  businessName    String
  businessType    String?
  Replies         Reply[]           @relation("businessReply")
  stores          Store[]           @relation("businessStores")
  addresses       BusinessAddress[] @relation("businessAddress")
  account         String            @unique
  businessAccount Account           @relation("businessAccount", fields: [account], references: [id], onDelete: Cascade)
}

model BusinessAddress {
  id              String   @id @default(uuid())
  country         String
  streetAddress   String
  appartmentNo    String?
  city            String
  phone           String
  business        String
  businessAddress Business @relation("businessAddress", fields: [business], references: [id], onDelete: Cascade)
}

model Store {
  id                String     @id @default(uuid())
  storeName         String     @default("Default")
  storeType         String
  promotion         Boolean    @default(false)
  promotionDiscount Int        @default(0)
  currency          String?    @default("GHS")
  products          Product[]  @relation("storeProducts")
  categories        Category[] @relation("storeCategories")
  template          Template?  @relation("storeTemplate")
  orders            Order[]    @relation("storeOrder")
  visitors          Visitor[]  @relation("storeVisitor")
  payments          Payout[]   @relation("storePayout")
  disbursementId    String?
  business          String
  businessStores    Business   @relation("businessStores", fields: [business], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Template {
  id             String   @id @default(uuid())
  name           String
  brandImage     String?
  brandColor     String?
  welcomeColor   String?
  welcomebtnText String?
  welcomeText    String?
  fontstyle      String?
  primaryColor   String?
  secondaryColor String?
  auxillaryColor String?
  storeStory     String?
  storeTeams     Team[]   @relation("storeTeams")
  storeReasons   Reason[] @relation("storeReasons")
  hasContactPage Boolean  @default(false)
  hasAboutPage   Boolean  @default(false)
  store          String   @unique
  temp           Temp?    @relation("temporaryTemplate")
  storeTemplate  Store    @relation("storeTemplate", fields: [store], references: [id], onDelete: Cascade)
}

model Reason {
  id               String    @id @default(uuid())
  title            String
  paragraph        String
  template         String?
  storeReasons     Template? @relation("storeReasons", fields: [template], references: [id], onDelete: Cascade)
  temp             String
  storeReasonsTemp Temp      @relation("storeReasonsTemp", fields: [temp], references: [id], onDelete: Cascade)
}

model Team {
  id             String    @id @default(uuid())
  picture        String
  key            String
  name           String
  role           String
  template       String?
  storeTeams     Template? @relation("storeTeams", fields: [template], references: [id], onDelete: Cascade)
  temp           String
  storeTeamsTemp Temp      @relation("storeTeamsTemp", fields: [temp], references: [id], onDelete: Cascade)
}

model Temp {
  id             String   @id @default(uuid())
  name           String
  brandImage     String?
  brandColor     String?
  welcomeColor   String?
  welcomebtnText String?
  welcomeText    String?
  fontstyle      String?
  primaryColor   String?
  secondaryColor String?
  auxillaryColor String?
  storeStory     String?
  tempTeams      Team[]   @relation("storeTeamsTemp")
  tempReasons    Reason[] @relation("storeReasonsTemp")
  hasContactPage Boolean  @default(false)
  hasAboutPage   Boolean  @default(false)
  template       String   @unique
  tempTemplate   Template @relation("temporaryTemplate", fields: [template], references: [id], onDelete: Cascade)
}

model Product {
  id               String      @id @default(uuid())
  name             String
  images           Image[]     @relation("productImages")
  description      String
  isActive         Boolean     @default(true)
  quantity         Int         @default(0)
  reStockLevel     Int         @default(0)
  category         String      @default("All")
  price            Float       @default(0.00)
  discount         Int         @default(0)
  promotionProduct Boolean     @default(false)
  variations       Variation[] @relation("productVariations")
  reviews          Review[]    @relation("productReviews")
  customerSave     SavedItem[] @relation("savedProduct")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  store            String
  storeProducts    Store       @relation("storeProducts", fields: [store], references: [id], onDelete: Cascade)
  orders           OrderItem[] @relation("productOrdered")
}

model Category {
  id              String @id @default(uuid())
  name            String
  store           String
  storeCategories Store  @relation("storeCategories", fields: [store], references: [id], onDelete: Cascade)
}

model Image {
  id           String  @id @default(uuid())
  url          String
  key          String
  product      String
  productImage Product @relation("productImages", fields: [product], references: [id], onDelete: Cascade)
}

model Variation {
  id                String  @id @default(uuid())
  type              String
  value             String
  product           String
  productVariations Product @relation("productVariations", fields: [product], references: [id], onDelete: Cascade)
}

enum Remarks {
  Disappointing
  Outstanding
  Satisfactory
}

model Review {
  id             String   @id @default(uuid())
  product        String
  rating         Int
  remarks        Remarks
  comment        String?
  customer       String
  replies        Reply[]  @relation("reviewReply")
  productReview  Product  @relation("productReviews", fields: [product], references: [id], onDelete: Cascade)
  customerReview Customer @relation("customerReviews", fields: [customer], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Reply {
  id            String   @id @default(uuid())
  comment       String?
  from          Type
  customer      String
  customerReply Customer @relation("customerReply", fields: [customer], references: [id], onDelete: Cascade)
  business      String
  buisnessReply Business @relation("businessReply", fields: [business], references: [id], onDelete: Cascade)
  review        String
  reviewReply   Review   @relation("reviewReply", fields: [review], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Status {
  Pending_Payment
  Delivered
  On_Hold
  Refunded
  Returned
  Cancelled
  Shipped
  Processing
  Completed
  Failed
}

model Order {
  id            String      @id @default(uuid())
  amount        Float
  paid          Boolean
  orderId       String
  status        Status
  store         String
  storeOrder    Store       @relation("storeOrder", fields: [store], references: [id], onDelete: Cascade)
  customer      String
  customerOrder Customer    @relation("customerOrder", fields: [customer], references: [id])
  items         OrderItem[] @relation("OrderItems")
  disbursement  Payout?     @relation("orderPayout")
  shipping      String
  orderShipping Shipping    @relation("orderShipping", fields: [shipping], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id             String  @id @default(uuid())
  quantity       Int     @default(1)
  price          Float   @default(0.00)
  discount       Int     @default(0)
  name           String
  image          String
  product        String
  productOrdered Product @relation("productOrdered", fields: [product], references: [id])
  order          String
  OrderItem      Order   @relation("OrderItems", fields: [order], references: [id], onDelete: Cascade)
}

model SavedItem {
  id                  String   @id @default(uuid())
  product             String
  savedProduct        Product  @relation("savedProduct", fields: [product], references: [id])
  customer            String
  customrSavedProduct Customer @relation("customerSavedProduct", fields: [customer], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
}

model Visitor {
  id                  String   @id @default(uuid())
  liked               Boolean  @default(false)
  store               String
  storeVisitor        Store    @relation("storeVisitor", fields: [store], references: [id])
  customer            String
  customrSavedProduct Customer @relation("visitedStore", fields: [customer], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
}

model Payout {
  id          String   @id @default(uuid())
  commission  Float
  payoutId    String
  batch       String?
  order       String   @unique
  orderPayout Order    @relation("orderPayout", fields: [order], references: [id])
  store       String
  storePayout Store    @relation("storePayout", fields: [store], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
