generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Type {
  Business
  Customer
}

enum Provider {
  local
  google
  facebook
}

model Account {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  type               Type
  provider           Provider
  providerId         String    @default(uuid())
  verificationToken  String?
  verified           Boolean   @default(false)
  isActive           Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  canResetPassword   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer? @relation("customerAccount")
  business           Business? @relation("businessAccount")
}

model Customer {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  phone           String?
  picture         String?
  reviews         Review[] @relation("customerReviews")
  Replies         Reply[]  @relation("customerReply")
  orders          Order[]  @relation("customerOrder")
  account         String   @unique
  customerAccount Account  @relation("customerAccount", fields: [account], references: [id], onDelete: Cascade)
}

model Business {
  id              String  @id @default(uuid())
  businessName    String
  contact         String?
  location        String?
  businessType    String?
  Replies         Reply[] @relation("businessReply")
  stores          Store[] @relation("businessStores")
  account         String  @unique
  businessAccount Account @relation("businessAccount", fields: [account], references: [id], onDelete: Cascade)
}

model Store {
  id                String     @id @default(uuid())
  storeName         String     @default("Default")
  storeType         String
  promotion         Boolean    @default(false)
  promotionDiscount Int        @default(0)
  currency          String?    @default("GHc")
  products          Product[]  @relation("storeProducts")
  categories        Category[] @relation("storeCategories")
  template          Template?  @relation("storeTemplate")
  orders            Order[]    @relation("storeOrder")
  business          String
  businessStores    Business   @relation("businessStores", fields: [business], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Template {
  id             String    @id @default(uuid())
  name           String
  brandImage     String?
  brandColor     String?
  welcomeColor   String?
  welcomebtnText String?
  welcomeText    String?
  fontstyle      String?
  primaryColor   String?
  secondaryColor String?
  auxillaryColor String?
  storeStory     String?
  storeTeams     Team[]    @relation("storeTeams")
  storeReasons   Reasons[] @relation("storeReasons")
  hasContactPage Boolean   @default(false)
  hasAboutPage   Boolean   @default(false)
  store          String    @unique
  temp           Temp?     @relation("temporaryTemplate")
  storeTemplate  Store     @relation("storeTemplate", fields: [store], references: [id], onDelete: Cascade)
}

model Reasons {
  id               String    @id @default(uuid())
  title            String
  paragraph        String
  template         String?
  storeReasons     Template? @relation("storeReasons", fields: [template], references: [id], onDelete: Cascade)
  temp             String
  storeReasonsTemp Temp      @relation("storeReasonsTemp", fields: [temp], references: [id], onDelete: Cascade)
}

model Team {
  id             String    @id @default(uuid())
  picture        String
  key            String
  name           String
  role           String
  template       String?
  storeTeams     Template? @relation("storeTeams", fields: [template], references: [id], onDelete: Cascade)
  temp           String
  storeTeamsTemp Temp      @relation("storeTeamsTemp", fields: [temp], references: [id], onDelete: Cascade)
}

model Temp {
  id             String    @id @default(uuid())
  name           String
  brandImage     String?
  brandColor     String?
  welcomeColor   String?
  welcomebtnText String?
  welcomeText    String?
  fontstyle      String?
  primaryColor   String?
  secondaryColor String?
  auxillaryColor String?
  storeStory     String?
  tempTeams      Team[]    @relation("storeTeamsTemp")
  tempReasons    Reasons[] @relation("storeReasonsTemp")
  hasContactPage Boolean   @default(false)
  hasAboutPage   Boolean   @default(false)
  template       String    @unique
  tempTemplate   Template  @relation("temporaryTemplate", fields: [template], references: [id], onDelete: Cascade)
}

model Product {
  id               String      @id @default(uuid())
  name             String
  images           Image[]     @relation("productImages")
  description      String
  isActive         Boolean     @default(true)
  quantity         Int         @default(0)
  reStockLevel     Int         @default(0)
  category         String      @default("All")
  price            Decimal     @default(0.00)
  discount         Int         @default(0)
  promotionProduct Boolean     @default(false)
  variations       Variation[] @relation("productVariations")
  reviews          Review[]    @relation("productReviews")
  orders           OrderItem[] @relation("orderedProduct")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  store            String
  storeProducts    Store       @relation("storeProducts", fields: [store], references: [id], onDelete: Cascade)
}

model Category {
  id              String @id @default(uuid())
  name            String
  store           String
  storeCategories Store  @relation("storeCategories", fields: [store], references: [id], onDelete: Cascade)
}

model Image {
  id           String  @id @default(uuid())
  url          String
  key          String
  product      String
  productImage Product @relation("productImages", fields: [product], references: [id], onDelete: Cascade)
}

model Variation {
  id                String  @id @default(uuid())
  type              String
  value             String
  product           String
  productVariations Product @relation("productVariations", fields: [product], references: [id], onDelete: Cascade)
}

enum Remarks {
  Disappointing
  Great
  Satisfied
}

model Review {
  id             String   @id @default(uuid())
  product        String
  rating         Int
  remarks        Remarks
  comment        String?
  customer       String
  replies        Reply[]  @relation("reviewReply")
  reviewedAt     DateTime @default(now())
  productReview  Product  @relation("productReviews", fields: [product], references: [id], onDelete: Cascade)
  customerReview Customer @relation("customerReviews", fields: [customer], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Reply {
  id            String   @id @default(uuid())
  comment       String?
  customer      String
  customerReply Customer @relation("customerReply", fields: [customer], references: [id], onDelete: Cascade)
  business      String
  buisnessReply Business @relation("businessReply", fields: [business], references: [id], onDelete: Cascade)
  repliedAt     DateTime @default(now())
  review        String
  reviewReply   Review   @relation("reviewReply", fields: [review], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  store         String
  storeOrder    Store    @relation("storeOrder", fields: [store], references: [id], onDelete: Cascade)
  customer      String
  customerOrder Customer @relation("customerOrder", fields: [customer], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderItem {
  id           String  @id @default(uuid())
  quantity     Int     @default(1)
  price        Decimal @default(0.00)
  discount     Int     @default(0)
  productName  String
  productImage String

  product        String
  orderedProduct Product @relation("orderedProduct", fields: [product], references: [id], onDelete: Cascade)
}

model Payment {
  id String @id @default(uuid())
}
